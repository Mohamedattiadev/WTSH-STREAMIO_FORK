# Copy this file to .env and fill in real values for local development.
# In Vercel, set these as Project > Settings > Environment Variables instead.

# Supabase project (Settings > API in the Supabase dashboard). The anon key is safe to expose
# client-side by design (Supabase enforces access via Row Level Security), but it still belongs
# in an env var, never hardcoded in source. Never put the service_role key here or anywhere in
# this app - it must only ever live server-side, and this app has no server-side code that needs it.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gemini API key for the "Ask WTS" Chat feature. Server-side only: this must be read by the
# serverless proxy function under api/, never injected into the client bundle the way the two
# Supabase vars above are (webpack.EnvironmentPlugin does not expose this one to the client).
GEMINI_API_KEY=

# TMDB v3 API key. Server-side only (read by api/reviews.js, api/hero-enrichment.js and the
# catalog half of api/addon/[...path].js). Free: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OpenSubtitles.com API key for the subtitles half of api/addon/[...path].js. Server-side only,
# never in any URL. OPTIONAL but strongly recommended: without it, subtitle *search* falls back
# to unauthenticated requests that opensubtitles.com rate-limits hard (HTTP 403 "You cannot
# consume this service") from a busy egress IP, so results will be spotty. Subtitle *downloads*
# are keyless either way. Free key (2 min): sign in at opensubtitles.com > Consumers > New
# consumer > copy the "Api Key".
OPENSUBTITLES_API_KEY=

# ============================================================================================
# Cache / proxy layer (api/_lib/cache). Sits in front of every server-side upstream this app
# calls (TMDB, OpenSubtitles, Internet Archive, Cinemeta). ALL of this is optional - with none
# of it set the layer runs an in-process memory cache, which is enough for local dev.
# ============================================================================================

# memory | redis. Omit it: "redis" is auto-selected the moment the two UPSTASH_* vars below are
# both set, otherwise "memory".
CACHE_BACKEND=

# Hot cache. In production: provision "Upstash Redis" from the Vercel Marketplace (Storage tab)
# and it injects these two automatically. For local dev against the docker-compose stack:
#   UPSTASH_REDIS_REST_URL=http://localhost:8079
#   UPSTASH_REDIS_REST_TOKEN=local-dev-token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# TTLs in seconds. These are the defaults - only set one to override it.
METADATA_CACHE_TTL=86400
CATALOG_CACHE_TTL=21600
SEARCH_CACHE_TTL=1800
STREAM_CACHE_TTL=300
SUBTITLE_CACHE_TTL=86400
IMAGE_CACHE_TTL=604800
ID_MAP_CACHE_TTL=2592000

# Stale-while-revalidate: serve a slightly-stale cached value immediately and refresh it in the
# background. CACHE_SWR_GRACE_RATIO is how much extra time past the TTL a value is kept usable
# (1 = one more TTL's worth). Freshness-critical paths (streams, tmdbId->imdbId) opt out in code.
CACHE_SWR_ENABLED=true
CACHE_SWR_GRACE_RATIO=1

# Cross-instance request coalescing (redis backend only): one instance calls the upstream on a
# miss, the rest wait for its result instead of each making their own call.
CACHE_SINGLEFLIGHT_LOCK=true

# How long a failed upstream is remembered as "don't retry yet" (seconds), so a broken upstream
# is not hammered by a wave of misses.
CACHE_NEGATIVE_TTL=30

# Set to a long random string to enable GET /api/cache-stats (hit rate, latency percentiles,
# dedup counts, cache size). It is a 403 until this is set. Send it as ?token= or the header
# x-cache-stats-token.
CACHE_STATS_TOKEN=

# Only the benchmark harness needs this - lets ?nocache=1 skip the cache.
CACHE_ALLOW_BYPASS=false

# --- Optional durable object store (OFF by default) ------------------------------------------
# A Telegram bot + one chat you own, used ONLY as a blob store for large static files (subtitle
# files). Redis keeps just a reference; Telegram keeps the bytes. It is a poor fit for hot JSON
# (Bot API round-trips are slower than re-fetching) - leave it off unless you specifically want
# subtitle files persisted off-Redis. The bot token is server-side only and never reaches the
# client. Setup: message @BotFather -> /newbot -> copy the token; add the bot to a private
# channel/group you own; TELEGRAM_CHAT_ID is that chat's id (e.g. -1001234567890).
OBJECT_STORAGE=none
TELEGRAM_STORAGE_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional background prefetch (OFF by default) -----------------------------------------
# A Vercel Cron (vercel.json) hits /api/cron/prefetch daily to warm the first-party catalog
# rows into the cache, so the first visitor after a TTL expiry still gets a hit. It only
# re-requests this app's own catalog endpoints - no scraping, no rate-limit games.
# CRON_SECRET is set in Vercel (Project Settings) and Vercel sends it as a Bearer token on the
# cron call; the endpoint refuses to run without it.
PREFETCH_ENABLED=false
PREFETCH_CONCURRENCY=3
CRON_SECRET=
